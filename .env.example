# Copier ce fichier en `.env.local` (développement) ou renseigner ces variables dans Vercel (production).
# Toutes les valeurs ci-dessous sont FICTIVES.

# URL publique de l'application. Local : http://localhost:3000 ; production : https://skai.example.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Projet Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# Clé publique (anon). Sans effet sans les politiques RLS, mais jamais de secret ici.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi.exemple.anon

# Clé service : SECRÈTE. Serveur uniquement (invitations, script de premier administrateur).
# Ne jamais la préfixer par NEXT_PUBLIC_. Ne jamais la committer.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi.exemple.service

# Adresse e-mail de la première personne du bureau (utilisée une seule fois par `npm run admin:create-first`).
FIRST_ADMIN_EMAIL=presidence@exemple.org

# Secret partagé avec Vercel Cron pour le rappel quotidien des échéances (/api/cron/echeances).
# Générez-le avec : openssl rand -hex 32 . Vercel l'envoie automatiquement dans l'en-tête Authorization.
CRON_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Envoi d’e-mails aux membres (synthèses et annonces). Facultatif : sans ces variables, rien n’est envoyé.
# MAIL_PROVIDER : "brevo" (gratuit, sans domaine) ou "resend" (gratuit, domaine vérifié requis).
MAIL_PROVIDER=brevo
# Clé API du fournisseur (Brevo : SMTP & API > Clés API ; Resend : API Keys). SECRÈTE.
MAIL_API_KEY=xkeysib-exemple-factice
# Adresse d’expéditeur, validée chez le fournisseur, et nom affiché.
MAIL_FROM_EMAIL=asso@exemple.org
MAIL_FROM_NAME=skAI Workspace
